# Variáveis da aplicação. Copie para backend/.env no servidor.
#   cp backend/.env.example backend/.env

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
# Gere uma nova:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(64))"
SECRET_KEY=
# Domínios que a API atende. Sem "*" — com DEBUG=False o sistema recusa subir.
ALLOWED_HOSTS=api-cobranca.suaempresa.com.br
# Origem do painel. É daqui que o navegador chama a API.
CORS_ALLOWED_ORIGINS=https://cobranca.suaempresa.com.br

# ── Banco ───────────────────────────────────────────────────────────────────
# A MESMA senha do .env da raiz. Host e porta vêm do compose.
POSTGRES_DB=cobrancas
POSTGRES_USER=cobrancas
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# ── Cifra dos segredos guardados no banco ───────────────────────────────────
# Protege as credenciais bancárias num dump do Postgres (backup extraviado,
# réplica esquecida, acesso de manutenção). Não protege contra invasão do
# servidor — quem lê este arquivo lê a chave.
#
# Vazia, a chave é derivada da SECRET_KEY: o sistema sobe igual, MAS trocar a
# SECRET_KEY depois tornará as credenciais ilegíveis e elas terão de ser
# recadastradas uma a uma. Gere a sua:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMPOS_CHAVE=

# ── Endereços públicos ──────────────────────────────────────────────────────
URL_PAINEL=https://cobranca.suaempresa.com.br
URL_API=https://api-cobranca.suaempresa.com.br
NOME_DO_SISTEMA=Plataforma de Cobranças

# ── Admin do Django ─────────────────────────────────────────────────────────
# Manutenção pontual, não operação. Desligado por padrão; ligado, nunca em
# /admin/.
ADMIN_ATIVO=False
ADMIN_URL=manutencao-a3f9/

# ── E-mail (envio de boleto ao sacado) ──────────────────────────────────────
# Sem host, o Django escreve no console e nada sai — o fluxo continua
# exercitável sem SMTP contratado.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=cobranca@suaempresa.com.br

# ── Operação em lote ────────────────────────────────────────────────────────
# Registros por transação ao processar arquivo grande.
LOTE_TAMANHO_BLOCO=500
# Teto de títulos num único lote de remessa.
LOTE_MAX_TITULOS=20000
# De quanto em quanto tempo o sistema procura retorno novo (minutos). O banco
# publica uma vez por dia útil; varrer de hora em hora custa quase nada e cobre
# republicação.
INTERVALO_VARRER_RETORNOS_MIN=60

# ── Tetos de requisição ─────────────────────────────────────────────────────
# Os padrões servem para a maioria. Suba só com motivo medido.
# THROTTLE_USER=600/min
# THROTTLE_BANCO=30/min
# THROTTLE_UPLOAD_RETORNO=60/hour

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7

LOG_LEVEL=INFO

# Desenvolvimento local. Copie para backend/.env:
#   cp backend/.env.exemplo-dev backend/.env
#
# As portas batem com docker-compose.yml (deslocadas para não brigar com um
# PostgreSQL nativo instalado na máquina).
DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=cobrancas
POSTGRES_USER=cobrancas
POSTGRES_PASSWORD=cobrancas
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2

URL_PAINEL=http://localhost:3000
URL_API=http://localhost:8000
ADMIN_ATIVO=True

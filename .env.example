# Variáveis da raiz — usadas apenas pelo docker-compose.prod.yml.
# Copie para .env no servidor:  cp .env.example .env

# Nome do projeto no Docker. PRECISA ser diferente do sistema anterior que roda
# na mesma VPS: é o que separa contêiner, volume e rede dos dois. Sem isto, um
# `docker compose down -v` num deles apagaria o banco do outro.
COMPOSE_PROJECT_NAME=cobrancas

# Domínios (já apontados para o IP do servidor antes de subir).
DOMINIO_PAINEL=cobranca.suaempresa.com.br
DOMINIO_API=api-cobranca.suaempresa.com.br

# URL pública da API — embutida no build do frontend.
API_URL=https://api-cobranca.suaempresa.com.br/api/v1

# Banco. A MESMA senha precisa estar em backend/.env.
POSTGRES_DB=cobrancas
POSTGRES_USER=cobrancas
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Fila. `noeviction` no Redis é intencional (ver docker-compose.prod.yml): com
# despejo ligado, o Redis descartaria tarefas em fila sob pressão de memória e
# um lote de 500 boletos sumiria sem erro. Se este teto for pequeno demais, o
# certo é aumentá-lo, não permitir o despejo.
REDIS_MAXMEMORY=256mb
# Processos do worker. Numa VPS de 2 GB, 2 é o teto prático: cada um carrega o
# Django inteiro.
CELERY_CONCURRENCY=2

# ------------------------------------------------------------------ Backup
# O dump tem a carteira de cobrança inteira de todos os clientes: nome, CPF,
# endereço, valores e pagamentos. Escolha UM caminho de cifragem — sem nenhum,
# o backup sai em claro e o envio para fora do servidor é recusado.
#
# Preferido: age (assimétrico). O servidor guarda só a chave pública, então
# invadir a máquina não dá acesso a backup nenhum.
#   apt install age
#   age-keygen -o chave-backup.txt     # GUARDE FORA DO SERVIDOR
#   BACKUP_CHAVE_PUBLICA=age1<...>     # a linha "Public key" do arquivo acima
BACKUP_CHAVE_PUBLICA=
# Só para restaurar: caminho do arquivo com a chave privada, trazido na hora.
BACKUP_CHAVE_PRIVADA=

# Alternativa: senha simétrica (openssl). Mais simples, porém a senha mora no
# mesmo servidor — protege o arquivo que vaza, não o servidor que cai.
BACKUP_SENHA=

# Cópia fora do servidor, via rclone (S3, Backblaze, Drive, outro servidor).
#   apt install rclone && rclone config
#   BACKUP_DESTINO_REMOTO=b2:cobrancas-backups
BACKUP_DESTINO_REMOTO=
